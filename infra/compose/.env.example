# Copiar a .env y completar. El .env no se sube al repositorio.
# Ojo: pgAdmin rechaza dominios reservados como .local en el correo.

# --- Base de datos ---
DB_NAME=restoyadb
DB_USER=restoya
DB_PASSWORD=cambiar_esta_clave
# Puerto en el host. El 5432 suele estar ocupado por otro Postgres.
DB_PORT_HOST=5433

# --- pgAdmin ---
PGADMIN_EMAIL=admin@restoya.com.ar
PGADMIN_PASSWORD=cambiar_esta_clave
PGADMIN_PORT=5050

# --- Copias de seguridad ---
# Cada cuantos segundos corre pg_dump. 3600 = una por hora.
BACKUP_INTERVALO=3600
# Cuantas copias se conservan antes de rotar.
BACKUP_RETENER=7

# --- Aplicacion ---
JWT_SECRET=una_clave_larga_y_aleatoria
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_esta_clave
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Que hace el backend con el esquema al arrancar.
#   none   -> no lo toca (valor de despliegue, y el unico valido para medir)
#   alter  -> sequelize.sync({alter:true}), el comportamiento viejo
#   create -> crea lo que falte, sin alterar lo que ya existe
DB_SYNC=none
# false evita que el arranque escriba los datos base.
DB_SEED=true

# Integraciones externas. Vacias en local: pagos, login con Google, correo
# y chatbot no funcionan sin ellas, el resto de la app si.
MP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_PASS=
GEMINI_API_KEY=
