# Copiar a .env y completar. El .env no se sube al repositorio.
# Ojo: pgAdmin rechaza dominios reservados como .local en el correo.

# --- Base de datos ---
DB_NAME=restoyadb
DB_USER=restoya
DB_PASSWORD=cambiar_esta_clave
# Puerto en el host. El 5432 suele estar ocupado por otro Postgres.
DB_PORT_HOST=5433

# --- pgAdmin ---
PGADMIN_EMAIL=admin@restoya.com.ar
PGADMIN_PASSWORD=cambiar_esta_clave
PGADMIN_PORT=5050

# --- Copias de seguridad ---
# Cada cuantos segundos corre pg_dump. 3600 = una por hora.
BACKUP_INTERVALO=3600
# Cuantas copias se conservan antes de rotar.
BACKUP_RETENER=7

# --- Aplicacion ---
JWT_SECRET=una_clave_larga_y_aleatoria
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_esta_clave
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Que hace el backend con el esquema al arrancar.
#   none   -> no lo toca (valor de despliegue, y el unico valido para medir)
#   alter  -> sequelize.sync({alter:true}), el comportamiento viejo
#   create -> crea lo que falte, sin alterar lo que ya existe
DB_SYNC=none
# false evita que el arranque escriba los datos base.
DB_SEED=true

# Integraciones externas. Vacias en local: pagos, login con Google, correo
# y chatbot no funcionan sin ellas, el resto de la app si.
MP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_PASS=
GEMINI_API_KEY=

# --- Monitoreo (punto 10) ---
# Los tres puertos quedan atados a 127.0.0.1. Los exportadores no publican
# ninguno: solo los consulta Prometheus por la red interna.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_USER=admin
# Sin esto el servicio no arranca, a proposito: Grafana sin contrasena puesta
# a mano usa admin/admin.
GRAFANA_PASSWORD=cambiar_esta_clave

# --- Seguridad (punto 14) ---
# Lista EXACTA de origenes permitidos por CORS, separados por coma.
# Ojo: tiene que ser el origen entero (esquema + host + puerto). La version
# vieja comparaba subcadenas y dejaba pasar onrender.com.sitio-falso.net.
#
# HAY QUE PONER TODOS LOS NOMBRES POR LOS QUE SE ABRE LA APLICACION, y son
# mas de los que parece. Lo de abajo se aprendio rompiendo (16/11):
#
#   - localhost y 127.0.0.1 son origenes DISTINTOS para el navegador,
#     aunque sean la misma maquina. Si solo esta localhost, entrar por
#     127.0.0.1 falla.
#   - El nombre publico del punto 9 TAMBIEN es un origen. Si falta, el
#     login del sitio publicado no funciona para nadie.
#
# Y el sintoma engania, porque el navegador y curl no se comportan igual:
# curl NO manda cabecera Origin, asi que una prueba con curl da 200 mientras
# el navegador recibe 500. Para reproducirlo hay que mandarla a mano:
#
#   curl -H "Origin: https://midominio.com" -X POST ... /api/auth/login
#
# Ademas el frontend muestra "Verifica tus credenciales" ante CUALQUIER
# error, asi que un 500 de CORS parece una clave equivocada.
CORS_ORIGENES=http://localhost:4200,http://localhost:8080,http://127.0.0.1:8080,https://midominio.com

# Intentos de inicio de sesion por IP cada 15 minutos. Estaba en 100, que es
# un permiso para probar contrasenas.
LIMITE_LOGIN=10
# Peticiones por minuto a toda la API, por IP.
LIMITE_API=300
# Consultas por minuto al chatbot. Va aparte y mas apretado porque reenvia a
# Gemini con la clave del proyecto: cada peticion cuesta plata.
LIMITE_CHATBOT=10

# La documentacion de la API no se sirve salvo que se pida aca, y aun asi pide
# usuario y contrasena. En despliegue queda en false.
SWAGGER_HABILITADO=false
SWAGGER_USER=docs
SWAGGER_PASSWORD=cambiar_esta_clave

# --- Replicacion (punto 6) ---
# El rol "replicador" NO puede leer ni escribir datos: solo tiene el atributo
# REPLICATION. Si la contrasena se filtra, alcanza para copiarse la base
# entera, que ya es bastante, pero no para conectarse a mirar una tabla.
REPLICACION_USER=replicador
REPLICACION_PASSWORD=cambiar_esta_clave
# Nombre de la ranura de replicacion. La ranura es lo que impide que el
# primario borre WAL que la replica todavia no aplico.
REPLICACION_RANURA=replica_1
# Puerto de la replica en el host. 5433 ya lo usa el primario.
DB_REPLICA_PORT_HOST=5434

# --- Punto 11: gestion de incidencias (MantisBT) ---
# Motor propio a proposito: Mantis es donde se anotan los problemas de la
# aplicacion, asi que no comparte base con ella.
MANTIS_DB_ROOT_PASSWORD=cambiar_esta_clave
MANTIS_DB_PASSWORD=cambiar_esta_clave
# Sal criptografica de Mantis: firma cookies y tokens. Tiene que ser distinta
# en cada instalacion. Si cambia, las sesiones abiertas se invalidan.
MANTIS_SALT=generar_con_openssl_rand_base64_32
MANTIS_PORT=8089
MAILPIT_PORT=8025

# --- Punto 12: gestion documental (Nextcloud) ---
NEXTCLOUD_DB_PASSWORD=cambiar_esta_clave
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=cambiar_esta_clave
NEXTCLOUD_PORT=8081

# --- Punto 13: automatizacion (n8n) ---
N8N_DB_PASSWORD=cambiar_esta_clave
# Cuenta de propietario de n8n. n8n 1.x NO tiene autenticacion basica: la
# unica autenticacion son las cuentas de usuario, y hasta que exista la de
# propietario n8n le ofrece crearla a cualquiera que entre. Darla de alta es
# parte de la puesta en marcha, no algo opcional. Ver docs/09-seguridad.md,
# hallazgo 15.
# La clave tiene que ser de 8 caracteres o mas, con al menos un numero y una
# mayuscula, o n8n la rechaza con un 400 sin explicar por que.
N8N_EMAIL=admin@restoya.com.ar
N8N_PASSWORD=cambiar_esta_clave
# Con esta clave n8n cifra las credenciales que guarda. Si se pierde o se
# cambia, las credenciales guardadas dejan de poder descifrarse y hay que
# volver a cargarlas todas.
N8N_ENCRYPTION_KEY=generar_con_openssl_rand_base64_32
N8N_PORT=5678

# --- Punto 9: publicacion en Internet (tunel de Cloudflare) ---
# El nombre publico con el que se llega a la aplicacion. Tiene que ser un
# subdominio de una zona que este en la cuenta de Cloudflare: el certificado
# que deja "cloudflared tunnel login" se emite para esa zona.
DOMINIO_PUBLICO=restoya.midominio.com
# El nombre del tunel. No pisa ningun otro tunel de la cuenta: el script solo
# mira si existe uno con ESTE nombre.
TUNEL_NOMBRE=restoya

# Los subdominios de las herramientas.
#
# Cada herramienta se publica en su propio nombre, en la MISMA zona que
# DOMINIO_PUBLICO. Un solo nivel: "n8n.midominio.com" si, "n8n.restoya.midominio.com"
# NO, porque el certificado gratuito de Cloudflare cubre el dominio y *.dominio,
# pero no un segundo nivel de subdominio, y el navegador corta con un error de
# certificado antes de llegar al tunel.
#
# Si se dejan vacios, cada herramienta sigue usando su direccion local
# (localhost:8089, localhost:3001, ...) y no hay que tocar nada mas. Son los
# valores por omision del docker-compose.yml.
#
# OJO: publicar estas herramientas abre a Internet la consola de
# automatizacion, el gestor de incidencias, la documentacion interna y el
# monitoreo. Las cuatro piden usuario y clave, pero la clave pasa a ser lo
# unico que las separa de cualquiera. Ver docs/09-seguridad.md, hallazgo 18.
ESQUEMA_PUBLICO=https
DOMINIO_N8N=n8n.midominio.com
DOMINIO_MANTIS=mantis.midominio.com
DOMINIO_NUBE=nube.midominio.com
DOMINIO_GRAFANA=grafana.midominio.com
