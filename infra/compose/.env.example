# Copiar a .env y completar. El .env no se sube al repositorio.
# Ojo: pgAdmin rechaza dominios reservados como .local en el correo.

# --- Base de datos ---
DB_NAME=restoyadb
DB_USER=restoya
DB_PASSWORD=cambiar_esta_clave
# Puerto en el host. El 5432 suele estar ocupado por otro Postgres.
DB_PORT_HOST=5433

# --- pgAdmin ---
PGADMIN_EMAIL=admin@restoya.com.ar
PGADMIN_PASSWORD=cambiar_esta_clave
PGADMIN_PORT=5050

# --- Copias de seguridad ---
# Cada cuantos segundos corre pg_dump. 3600 = una por hora.
BACKUP_INTERVALO=3600
# Cuantas copias se conservan antes de rotar.
BACKUP_RETENER=7

# --- Aplicacion ---
JWT_SECRET=una_clave_larga_y_aleatoria
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_esta_clave
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Que hace el backend con el esquema al arrancar.
#   none   -> no lo toca (valor de despliegue, y el unico valido para medir)
#   alter  -> sequelize.sync({alter:true}), el comportamiento viejo
#   create -> crea lo que falte, sin alterar lo que ya existe
DB_SYNC=none
# false evita que el arranque escriba los datos base.
DB_SEED=true

# Integraciones externas. Vacias en local: pagos, login con Google, correo
# y chatbot no funcionan sin ellas, el resto de la app si.
MP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_PASS=
GEMINI_API_KEY=

# --- Monitoreo (punto 10) ---
# Los tres puertos quedan atados a 127.0.0.1. Los exportadores no publican
# ninguno: solo los consulta Prometheus por la red interna.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_USER=admin
# Sin esto el servicio no arranca, a proposito: Grafana sin contrasena puesta
# a mano usa admin/admin.
GRAFANA_PASSWORD=cambiar_esta_clave

# --- Seguridad (punto 14) ---
# Lista EXACTA de origenes permitidos por CORS, separados por coma.
# Ojo: tiene que ser el origen entero (esquema + host + puerto). La version
# vieja comparaba subcadenas y dejaba pasar onrender.com.sitio-falso.net.
CORS_ORIGENES=http://localhost:4200,http://localhost:8080

# Intentos de inicio de sesion por IP cada 15 minutos. Estaba en 100, que es
# un permiso para probar contrasenas.
LIMITE_LOGIN=10
# Peticiones por minuto a toda la API, por IP.
LIMITE_API=300
# Consultas por minuto al chatbot. Va aparte y mas apretado porque reenvia a
# Gemini con la clave del proyecto: cada peticion cuesta plata.
LIMITE_CHATBOT=10

# La documentacion de la API no se sirve salvo que se pida aca, y aun asi pide
# usuario y contrasena. En despliegue queda en false.
SWAGGER_HABILITADO=false
SWAGGER_USER=docs
SWAGGER_PASSWORD=cambiar_esta_clave
